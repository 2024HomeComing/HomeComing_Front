<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white">

                <!-- newLOGO 이미지 -->
                <ImageView
                    android:id="@+id/new_logo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/group6"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:layout_marginTop="100dp"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="50dp"
                    android:layout_marginEnd="50dp"/>

                <!-- 검정색 선 -->
                <View
                    android:id="@+id/black_line"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginStart="50dp"
                    android:layout_marginEnd="50dp"
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/nameboard"
                    android:layout_marginTop="30dp"
                    android:background="@android:color/black" />

                <!-- 네임보드 이미지 -->
                <ImageView
                    android:id="@+id/nameboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/nameboard"
                    android:layout_below="@id/new_logo"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="20dp" />

                <!-- 카카오 로그인 버튼 -->
                <ImageButton
                    android:id="@+id/kakao_login_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/black_line"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="40dp"
                    android:src="@drawable/kakao_login_button"
                    android:padding="0dp"
                    tools:ignore="SpeakableTextPresentCheck" />

                <!-- 네이버 로그인 버튼 -->
                <ImageButton
                    android:id="@+id/naver_login_button"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:layout_below="@id/kakao_login_button"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/naver_login_button"
                    tools:ignore="SpeakableTextPresentCheck" />

        </RelativeLayout>

</LinearLayout>
