<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="50dp"
    tools:context=".WrittenWitnessFragment">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wtitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="목격신고 게시글 상세 페이지"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="16dp"
                android:layout_marginBottom="8dp"/>

            <ImageView
                android:id="@+id/wpetimg"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:src="@drawable/logo"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:backgroundTint="@color/black">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="동물 정보"
                    android:textSize="25dp"/>

                <TextView
                    android:id="@+id/wbreedTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="품종 : "
                    android:textSize="20dp"/>


                <TextView
                    android:id="@+id/wsizeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="크기 : "
                    android:textSize="20dp"/>

                <TextView
                    android:id="@+id/wcolorTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="털색 : "
                    android:textSize="20dp"/>

                <TextView
                    android:id="@+id/wcharacteristicsTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="특징 : "
                    android:textSize="20dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:backgroundTint="@color/black"
                android:paddingVertical="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="실종/목격 정보"
                    android:textSize="25dp"/>

                <TextView
                    android:id="@+id/wlastSeenLocationTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="마지막 확인 위치 : "
                    android:textSize="20dp"/>

                <TextView
                    android:id="@+id/wlastSeenTimeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="확인 시기 : "
                    android:textSize="20dp"/>

                <TextView
                    android:id="@+id/wcontactTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="연락처:"
                    android:textSize="20dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/wadditionalInfoTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="추가적인 특징 : "
                android:textSize="25dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="댓글"
                    android:textSize="25dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/commentsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/commentEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#F0F0F0"
                    android:hint="댓글을 작성해 주세요"
                    android:textSize="20dp">
                </EditText>

                <Button
                    android:id="@+id/postCommentButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/white"
                    android:textColor="@color/black"
                    android:text="작성"
                    android:textSize="10dp">
                </Button>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>